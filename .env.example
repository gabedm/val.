# Names only. Save values in ignored local files or deployment secrets.
VAL_BUILD_PROFILE=public
AI_BUDGET_USD=5
DATABASE_URL=
# Project-billed Gemini with Application Default Credentials; no Google API key.
VAL_MODEL_PROVIDER=google
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Optional local ADC path and service-account impersonation. On Cloud Run use its assigned identity.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
# Explicit alternatives only; neither is a fallback when Gemini is selected.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APP_ORIGIN=
PORT=
SESSION_SECRET=
# Stable account lookup key. On an existing installation, pin the ORIGINAL session
# secret here before rotating SESSION_SECRET. New installations use a separate random key.
DATA_SECRET=
# Optional named wallet encryption keys (JSON object) and the key used for new writes.
# Keep old keys until their saved connections have been re-encrypted or disconnected.
WALLET_ENCRYPTION_KEYS=
WALLET_ENCRYPTION_KEY_ID=
# Optional verified ingress peer CIDRs, comma separated. Leave blank for direct access.
TRUSTED_PROXY_CIDRS=
# Local review/admin accounts are disabled in the public profile.
JUDGE_USERNAME=
JUDGE_PASSWORD_HASH=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
PAYPAL_A_CLIENT_ID=
PAYPAL_A_CLIENT_SECRET=
PAYPAL_A_WEBHOOK_ID=
PAYPAL_B_CLIENT_ID=
PAYPAL_B_CLIENT_SECRET=
PAYPAL_B_WEBHOOK_ID=
# Identity is configured separately; never enables payment authority. Keep Sandbox for the demo.
PAYPAL_IDENTITY_ENVIRONMENT=sandbox
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
# Live identity requires PayPal approval, HTTPS and a fresh database. Do not combine with Sandbox keys.
PAYPAL_LIVE_LOGIN_CLIENT_ID=
PAYPAL_LIVE_LOGIN_CLIENT_SECRET=
VAL_LIVE_DISCOVERY=true
# Optional PayPal statement ingestion through KERNEL. Server credentials only.
VAL_PAYPAL_WALLET=false
KERNEL_API_KEY=
PAYPAL_WALLET_ENVIRONMENT=sandbox
KERNEL_MAX_CONCURRENT_BROWSERS=2
KERNEL_DAILY_IMPORT_LIMIT=10
# Separate financial capability; enable only after provider acceptance.
VAL_KERNEL_SWITCHING=false
KERNEL_SWITCH_API_KEY=
# Inspect current provider terms while blocking purchases and cancellations.
VAL_SWITCH_PREPARATION_ONLY=false
VAL_SWITCH_ENVIRONMENT=sandbox
# HTTPS origins of isolated providers you control, never commercial checkout sites.
VAL_SWITCH_TEST_ORIGINS=
VAL_SWITCH_LIVE=false
# Optional hosted Sandbox example. Public installations leave this disabled.
# Provider data and operator credentials belong only in private server configuration.
VAL_SWITCH_EXAMPLE=false
SWITCH_EXAMPLE_ORIGIN=
SWITCH_EXAMPLE_OPERATOR_KEY=
SWITCH_EXAMPLE_COMPANY=
SWITCH_EXAMPLE_PURPOSE=
# Judge invitation is separate from Val/PayPal account login; shared additional app budget.
JUDGE_DEMO_BUDGET_USD=5
VAL_JUDGE_DEMO=false
# Temporary local owner testing only. Keep false for hosting and judge builds; preserves the shared budget.
VAL_JUDGE_ACCESS_PAUSED=false
JUDGE_DEMO_USERNAME=judge
JUDGE_DEMO_PASSWORD_HASH=
# Optional operator-owned Sandbox test agreements. Private JSON bindings contain
# merchant, id, planId, customId, serviceId and name; never prices or usage answers.
# Hosted use requires the judge profile and invitation gate. Loopback owner testing
# may pause the invitation; the budget and visitor isolation remain enabled.
# Cannot be combined with wallet ingestion.
PAYPAL_SANDBOX_SUBSCRIPTIONS_JSON=
# Optional one-click entry to the preconnected Sandbox demo. Never enables live login.
VAL_PAYPAL_SANDBOX_DEMO_ENTRY=false
# Optional separate owner invitation, sharing the existing demo budget and controls.
OWNER_ACCESS_USERNAME=
OWNER_ACCESS_PASSWORD_HASH=
