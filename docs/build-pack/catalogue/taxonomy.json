  "assignment": "Editorial classification inferred from provider descriptions, not a third-party certification.",
  "comparison_checks": [
    "Ask the user's purpose before selecting a comparison group. A category alone never establishes substitutability.",
    "Require explicit evidence for each must-have feature, quantitative limit and desired content title. Retrieval tags alone are insufficient.",
    "Confirm country eligibility and a current price in the user's currency. Do not convert currencies or imply UK availability.",
    "Compare actual billing amount, term, seats, tax, shipping, renewal and existing bundle entitlement. Monthly equivalents are not monthly debits.",
    "Filter business/team and student-only plans unless the user's eligibility and seat requirements fit.",
    "Treat absent facts as unknown. Stay, no suitable replacement and ask for evidence are valid outcomes.",
    "Separate recommendation from execution. These entries authorize no purchase, cancellation or migration."
  ],
  "category_checks": {
    "video": [
      "Required titles, territory, ads, video quality, download eligibility and concurrency."
    ],
    "audio": [
      "Individual/family, listening-hour or credit limits, audio format, permanent ownership versus rented access."
    ],
    "gaming": [
      "Hardware/OS, platform, required titles, ownership, subscription access, base-game prerequisites and cloud latency."
    ],
    "wellness": [
      "Equipment, device, exercise type, accessibility and free/bundled alternatives; no medical outcome promises."
    ],
    "learning": [
      "Language, skill level, course inclusion, live teaching, certificates and eligibility; no employment outcome promises."
    ],
    "productivity": [
      "Solo/team, required document structure, export formats, devices and real history-preservation proof."
    ],
    "creative": [
      "Authoring platform, project compatibility, licence rights, credits, seats and site/workspace costs."
    ],
    "security": [
      "Capacity, encryption needs, retention, recovery, device count and purpose: backup, file sync, VPN and passwords are different."
    ],
    "reading": [
      "Required publications, language, geography, borrowed versus purchased books and existing library access."
    ],
    "home": [
      "Delivery postcode, quantity/frequency, minimum baskets, shipping, pet species/allergies and fresh ingredients versus flavour kits."
    ]
  }
