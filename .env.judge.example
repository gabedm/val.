# Separate deployment: fresh judge database, separate session secret and judge-specific provider keys.
VAL_BUILD_PROFILE=judge
VAL_ENV_FILE=.env.judge.local
VAL_PLAN_MAPPING_FILE=private/judge-paypal-plans.json
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:13219
PORT=13219
SESSION_SECRET=
VAL_MODEL_PROVIDER=google
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VAL_JUDGE_DEMO=true
JUDGE_DEMO_USERNAME=judge
JUDGE_DEMO_PASSWORD_HASH=
JUDGE_DEMO_BUDGET_USD=5
# Optional password-free private link. Keep the actual random token outside source.
VAL_PRIVATE_LINK_SHA256=
VAL_PRIVATE_LINK_EXPIRES_AT=
JUDGE_USERNAME=reviewer
JUDGE_PASSWORD_HASH=
ADMIN_USERNAME=administrator
ADMIN_PASSWORD_HASH=
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYPAL_A_CLIENT_ID=
PAYPAL_A_CLIENT_SECRET=
PAYPAL_A_WEBHOOK_ID=
PAYPAL_B_CLIENT_ID=
PAYPAL_B_CLIENT_SECRET=
PAYPAL_B_WEBHOOK_ID=
VAL_LIVE_DISCOVERY=true
# Optional one-click test entry; requires real Sandbox bindings and merchant credentials.
PAYPAL_SANDBOX_SUBSCRIPTIONS_JSON=
VAL_PAYPAL_SANDBOX_DEMO_ENTRY=false
